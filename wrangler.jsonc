{
  // Config de raíz para los despliegues de Cloudflare Workers Builds.
  //
  // En local el build de vinext escribe .wrangler/deploy/config.json, que
  // redirige a dist/server/wrangler.json y manda sobre este archivo. Pero en CI
  // se clona sin dist/ ni .wrangler/ (ambos ignorados por git), y sin config
  // wrangler intenta convertir el proyecto a OpenNext. De ahi este archivo: su
  // build.command genera dist/ antes de publicar.
  //
  // Si cambia algo en el config generado (compat date, flags, assets), cambialo
  // aqui tambien.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mr-shaky",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node scripts/run-framework.mjs build" },
  "main": "dist/server/index.js",
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "dist/client" },
  "observability": { "enabled": true },
  "legacy_env": true
}
